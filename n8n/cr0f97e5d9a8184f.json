  {
   "parameters": {
    "jsCode": "const envelope = $json;\nif (!envelope || envelope.type !== 'admission.pass.redeemed' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst data = envelope.data ?? {};\nfor (const key of ['public_reference', 'redeemed_at']) {\n  if (data[key] === undefined || data[key] === null || data[key] === '') throw new Error(`Missing redemption field: ${key}`);\n}\nreturn [{ json: { event_id: envelope.id, mail: {\n  operation: 'event', template: 'crowdrelay-admission-redeemed', variables: data, idempotency_key: envelope.id\n} } }];"
   },
   "id": "79186b28-3843-428b-9ec9-f0ea0ab55d06",
   "name": "Validate and build action",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://virya-crowdrelay-n8n-bridge:8080/mailer",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Idempotency-Key",
       "value": "={{ $json.event_id }}"
      }
     ]
    },
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "application/json",
    "body": "={{ JSON.stringify($json.mail) }}",
    "options": {
     "timeout": 40000
    },
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth"
   },
