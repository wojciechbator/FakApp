  {
   "id": "494b231a-2e34-46f0-9862-daff90a7d45a",
   "name": "Validate and build interest notification",
   "type": "n8n-nodes-base.code",
   "position": [
    240,
    0
   ],
   "parameters": {
    "jsCode": "const envelope = $json;\nif (!envelope || envelope.type !== 'event.interest_registered' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst data = envelope.data ?? {};\nif (!data.event_id || !data.fan_id) throw new Error('Missing event interest fields');\nconst marker = `CR_EVENT_ID:${envelope.id}`;\nconst source = String(data.source ?? 'unknown').slice(0, 80);\nconst content = [\n  'Nowe zainteresowanie koncertem',\n  `Event: ${String(data.event_id).slice(0, 100)}`,\n  `\u0179r\u00f3d\u0142o: ${source}`,\n  `Nowy zapis: ${Boolean(data.created) ? 'tak' : 'nie'}`,\n  marker,\n].join('\\n').slice(0, 1900);\nreturn [{ json: { marker, content } }];"
   },
   "typeVersion": 2
  },
  {
   "id": "e61992a5-92b4-4845-8ec7-fb0da75f5086",
   "name": "Read recent Discord messages",
   "type": "n8n-nodes-base.httpRequest",
   "maxTries": 5,
   "position": [
    500,
    0
   ],
   "parameters": {
    "url": "https://discord.com/api/v10/channels/1529482376458276964/messages",
    "method": "GET",
    "options": {
     "timeout": 30000,
     "response": {
      "response": {
       "responseFormat": "json"
      }
     }
    },
    "sendQuery": true,
    "sendHeaders": true,
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "queryParameters": {
     "parameters": [
      {
       "name": "limit",
       "value": "100"
      }
     ]
    },
    "headerParameters": {
     "parameters": [
      {
       "name": "User-Agent",
       "value": "Virya-n8n/1.0 (https://virya.music)"
      }
     ]
    }
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "FB7ONYMUsZFfObWB",
     "name": "Discord Bot HTTP"
    }
   },
   "retryOnFail": true,
   "typeVersion": 4.2,
   "waitBetweenTries": 5000
  },
  {
   "id": "f12b33cc-b533-4626-9af4-5052bb1fffd5",
   "name": "Check Discord external idempotency",
   "type": "n8n-nodes-base.code",
   "position": [
    760,
    0
   ],
   "parameters": {
    "jsCode": "const source = $('Validate and build interest notification').first().json;\nconst messages = Array.isArray($json) ? $json : [];\nreturn [{ json: { ...source, alreadySent: messages.some(message => String(message.content || '').includes(source.marker)) } }];"
   },
   "typeVersion": 2
  },
  {
   "id": "c682080f-d8ee-460b-8e20-d7533f2ddea7",
