  },
  {
   "parameters": {
    "jsCode": "const envelope = $json;\nif (!envelope || !new Set(['merch_coupon.issued', 'merch.coupon_issued']).has(String(envelope.type)) || envelope.version !== 1) {\n  throw new Error('Unsupported CrowdRelay event');\n}\nconst data = envelope.data ?? envelope.payload ?? {};\nfor (const key of ['email', 'coupon_code', 'discount_percent', 'expires_at']) {\n  if (data[key] === undefined || data[key] === null || data[key] === '') {\n    throw new Error(`Missing merch coupon field: ${key}`);\n  }\n}\nreturn [{\n  json: {\n    event_id: envelope.id,\n    fan_id: data.fan_id,\n    mail: {\n      template: 'crowdrelay-merch-reward',\n      to: data.email,\n      variables: {\n        display_name: data.display_name ?? null,\n        coupon_code: data.coupon_code,\n        discount_percent: data.discount_percent,\n        expires_at: data.expires_at,\n        qualified_referral_count: data.qualified_referral_count ?? null\n      },\n      idempotency_key: envelope.id\n    }\n  }\n}];"
   },
   "id": "e51b966b-b013-4ce6-8ca1-200000000002",
   "name": "Validate and build mail",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://virya-crowdrelay-n8n-bridge:8080/mailer",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Idempotency-Key",
       "value": "={{ $json.event_id }}"
      }
     ]
    },
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "application/json",
    "body": "={{ JSON.stringify($json.mail) }}",
    "options": {
     "timeout": 40000
    },
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth"
   },
   "id": "e51b966b-b013-4ce6-8ca1-200000000003",
   "name": "Send through Virya mailer",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    540,
    0
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 10000,
   "credentials": {
    "httpHeaderAuth": {
     "id": "viryaBridgeHeaderAuthV10",
     "name": "Virya CrowdRelay control-plane bridge"
    }
   },
