  {
   "id": "05183e3f-df1d-4fd4-b3ab-264d6a102781",
   "name": "Parse Meta Batch",
   "type": "n8n-nodes-base.code",
   "position": [
    1648,
    544
   ],
   "parameters": {
    "jsCode": "const selected = $('Select up to 30 + Build Meta Batch').first().json;\nconst raw = items[0]?.json;\nconst responses = Array.isArray(raw) ? raw : (Array.isArray(raw?.body) ? raw.body : raw);\nif (!Array.isArray(responses)) {\n  throw new Error(`Meta batch returned unexpected payload: ${JSON.stringify(raw).slice(0,800)}`);\n}\nconst rows = selected.candidates.map((target, idx) => {\n  const r = responses[idx] || {};\n  let body = {};\n  try { body = typeof r.body === 'string' ? JSON.parse(r.body) : (r.body || {}); } catch {}\n  const bd = body.business_discovery || {};\n  const media = bd.media?.data?.[0] || {};\n  return {\n    ...target,\n    metaCode: r.code || 0,\n    metaError: body.error?.message || '',\n    Latest_Post_URL: media.permalink || target.Latest_Post_URL || '',\n    Latest_Post_Caption: media.caption || '',\n    Latest_Post_Timestamp: media.timestamp || '',\n    Followers_Count: bd.followers_count || '',\n    Profile_Name: bd.name || '',\n  };\n});\nreturn [{json: {selectedAt: selected.selectedAt, rows}}];"
   },
   "typeVersion": 2
  },
  {
   "id": "7a34f243-d214-427a-bef0-0fafdb38823b",
   "name": "Build Gemini Comment Prompt",
   "type": "n8n-nodes-base.code",
   "position": [
    1888,
    544
   ],
   "parameters": {
    "jsCode": "const rows = $json.rows || [];\nconst payload = rows.map((r, i) => ({\n  index: i,\n  username: r.Username,\n  category: r.Category || '',\n  caption: String(r.Latest_Post_Caption || '').slice(0, 1200),\n  url: r.Latest_Post_URL || '',\n  error: r.metaError || ''\n}));\nconst prompt = `You are the organic community assistant for VIRYA, a Polish modern/alternative metal band.\nFor each item, propose ONE brief, authentic comment that a real band member could leave manually.\nRules:\n- use the language of the source caption when obvious; otherwise English;\n- 4-18 words;\n- reference a concrete detail from the caption;\n- no generic \"great post\", no spam, no sales pitch, no asking for follows;\n- no emojis unless the source tone clearly uses them;\n- if the item has an error or no post URL, return an empty comment.\nReturn ONLY a valid JSON array of objects:\n[{\"index\":0,\"comment\":\"...\",\"reason\":\"short internal reason\"}]\n\nINPUT:\n${JSON.stringify(payload)}`;\nreturn [{json: {...$json, geminiRequest: {\n  contents: [{role: 'user', parts: [{text: prompt}]}],\n  generationConfig: {\n    temperature: 0.35,\n    responseMimeType: 'application/json'\n  }\n}}}];"
   },
   "typeVersion": 2
  },
  {
   "id": "8dace3be-11bb-4a3b-86f9-905a5bc32a06",
   "name": "Gemini \u2014 Suggested Comments",
   "type": "n8n-nodes-base.httpRequest",
   "position": [
    2128,
    544
   ],
   "parameters": {
    "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + $('Config \u2014 \u0141azikomat').first().json.geminiModel + ':generateContent' }}",
    "method": "POST",
    "options": {
     "response": {
      "response": {
       "responseFormat": "json"
      }
     }
    },
    "jsonBody": "={{ JSON.stringify($json.geminiRequest) }}",
    "sendBody": true,
    "specifyBody": "json",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth"
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "8LSEwbWubxhnFYYB",
     "name": "Header Auth account"
    }
   },
   "typeVersion": 4.2
  },
  {
   "id": "ca17a188-392d-4819-b153-bf43b704a7e7",
   "name": "Prepare Sheet Rows",
   "type": "n8n-nodes-base.code",
   "position": [
    2368,
    544
   ],
   "parameters": {
    "jsCode": "const cfg = $('Config \u2014 \u0141azikomat').first().json;\nconst source = $('Build Gemini Comment Prompt').first().json;\nconst resp = items[0]?.json || {};\nconst text = resp.candidates?.[0]?.content?.parts?.map(p => p.text || '').join('') || '[]';\nlet suggestions = [];\ntry {\n  suggestions = JSON.parse(text.replace(/^```json\\s*/i,'').replace(/```$/,'').trim());\n} catch {\n  suggestions = [];\n}\nconst byIndex = new Map((Array.isArray(suggestions) ? suggestions : []).map(x => [Number(x.index), x]));\nconst now = new Date(source.selectedAt || Date.now());\nconst review = new Date(now);\nreview.setDate(review.getDate() + Number(cfg.cooldownDays || 7));\nconst stamp = now.toISOString().replace(/[-:.TZ]/g,'').slice(0,14);\n\nconst logs = [];\nconst targets = [];\nsource.rows.forEach((r, i) => {\n  const sug = byIndex.get(i) || {};\n  const hasPost = Boolean(r.Latest_Post_URL);\n  const status = r.metaError ? 'API_ERROR' : (hasPost ? 'QUEUED' : 'NEW');\n  logs.push({\n    Event_ID: `ENG-${stamp}-${String(i+1).padStart(2,'0')}`,\n    Selected_At: now.toISOString(),\n    Username: r.Username,\n    Profile_URL: r.Profile_URL || `https://www.instagram.com/${String(r.Username).replace(/^@/,'')}/`,\n    Platform: 'INSTAGRAM',\n    Suggested_Action: hasPost ? 'MANUAL_LIKE_AND_COMMENT' : 'OPEN_PROFILE_MANUALLY',\n    Latest_Post_URL: r.Latest_Post_URL || '',\n    Suggested_Comment: hasPost ? String(sug.comment || '') : '',\n    Completed_At: '',\n    Review_After: review.toISOString(),\n    Review_Status: 'PENDING',\n    Outcome: '',\n    Source: r.Source || 'ENGAGEMENT_TARGETS',\n    Notes: r.metaError || String(sug.reason || '')\n  });\n  targets.push({\n    Active: r.Active,\n    Username: r.Username,\n    Profile_URL: r.Profile_URL || `https://www.instagram.com/${String(r.Username).replace(/^@/,'')}/`,\n    Platform: 'INSTAGRAM',\n    Category: r.Category || '',\n    Priority: r.Priority || '',\n    Source: r.Source || '',\n    Last_Selected_At: now.toISOString(),\n    Cooldown_Until: review.toISOString(),\n    Interaction_Status: status,\n    Latest_Post_URL: r.Latest_Post_URL || '',\n    Latest_Post_Caption: r.Latest_Post_Caption || '',\n    Suggested_Comment: hasPost ? String(sug.comment || '') : '',\n    Notes: r.metaError || r.Notes || ''\n  });\n});\nreturn [{json:{logs, targets}}];"
   },
   "typeVersion": 2
  },
