   ],
   "parameters": {
    "jsCode": "const now = new Date();\nconst due = items.map(i=>i.json).filter(r => {\n  if (String(r.Review_Status || '').toUpperCase() !== 'PENDING') return false;\n  if (!r.Review_After) return false;\n  const d = new Date(r.Review_After);\n  return !Number.isNaN(d.getTime()) && d <= now;\n});\nif (!due.length) return [];\nconst chunks = [];\nfor (let i=0; i<due.length; i+=15) {\n  const text = due.slice(i,i+15).map((r,j) =>\n    `**${i+j+1}. @${String(r.Username||'').replace(/^@/,'')}** \u2014 ${r.Profile_URL || ''}\\n` +\n    `Zmie\u0144 w ENGAGEMENT_LOG: Review_Status \u2192 KEEP / ARCHIVE / SKIP.`\n  ).join('\\n\\n');\n  chunks.push({message:`## VIRYA \u2014 7-dniowy przegl\u0105d relacji\\nTo nie jest automatyczne odlajkowanie. Sprawd\u017a, czy profil jest warto\u015bciowy i zdecyduj r\u0119cznie.\\n\\n${text}`});\n}\nreturn chunks.map(x=>({json:x}));"
   },
