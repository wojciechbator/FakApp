  {
   "id": "d8c55234-fef6-4fc2-9b26-92f1a0f465d6",
   "name": "Select up to 30 + Build Meta Batch",
   "type": "n8n-nodes-base.code",
   "position": [
    928,
    624
   ],
   "parameters": {
    "jsCode": "const cfg = $('Config \u2014 \u0141azikomat').first().json;\nconst now = new Date();\nconst toBool = (v) => ['true','1','yes','tak','active'].includes(String(v ?? '').trim().toLowerCase());\nconst candidates = items\n  .map(i => i.json)\n  .filter(r => toBool(r.Active))\n  .filter(r => String(r.Platform || 'INSTAGRAM').toUpperCase() === 'INSTAGRAM')\n  .filter(r => r.Username && !String(r.Username).includes('UZUPE\u0141NIJ'))\n  .filter(r => {\n    if (!r.Cooldown_Until) return true;\n    const d = new Date(r.Cooldown_Until);\n    return Number.isNaN(d.getTime()) || d <= now;\n  })\n  .sort((a,b) => {\n    const pa = Number(a.Priority || 0);\n    const pb = Number(b.Priority || 0);\n    if (pb !== pa) return pb - pa;\n    const la = a.Last_Selected_At ? new Date(a.Last_Selected_At).getTime() : 0;\n    const lb = b.Last_Selected_At ? new Date(b.Last_Selected_At).getTime() : 0;\n    return la - lb;\n  })\n  .slice(0, Number(cfg.dailyLimit || 30));\n\nif (!candidates.length) {\n  return [{json: {skip: true, reason: 'Brak profili poza cooldownem.'}}];\n}\n\nconst fields = (username) =>\n  `business_discovery.username(${username}){username,name,profile_picture_url,followers_count,media.limit(1){id,caption,permalink,timestamp,media_type}}`;\n\nconst batch = candidates.map(t => ({\n  method: 'GET',\n  relative_url: `${cfg.igUserId}?fields=${encodeURIComponent(fields(String(t.Username).replace(/^@/, '')))}`\n}));\n\nreturn [{\n  json: {\n    skip: false,\n    selectedAt: now.toISOString(),\n    candidates,\n    batch\n  }\n}];"
   },
   "typeVersion": 2
  },
