  {
   "id": "1e9b1e4c-3d35-4659-9a16-6cd30f7dde33",
   "name": "Meta Business Discovery Batch",
   "type": "n8n-nodes-base.httpRequest",
   "notes": "Po uzyskaniu ko\u0144cowych uprawnie\u0144 Meta wykonaj test r\u0119czny. Batch ma maksymalnie 30 zapyta\u0144.",
