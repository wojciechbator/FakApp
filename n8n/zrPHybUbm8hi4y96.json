   ],
   "parameters": {
    "jsCode": "const logs = $('Prepare Sheet Rows').first().json.logs || [];\nconst usable = logs.filter(x => x.Profile_URL);\nconst chunks = [];\nfor (let i=0; i<usable.length; i+=10) {\n  const block = usable.slice(i,i+10).map((x, j) => {\n    const n = i+j+1;\n    const action = x.Latest_Post_URL || x.Profile_URL;\n    const comment = x.Suggested_Comment ? `\\n\ud83d\udcac ${x.Suggested_Comment}` : '';\n    return `**${n}. @${String(x.Username).replace(/^@/,'')}**\\n\ud83d\udd17 ${action}${comment}`;\n  }).join('\\n\\n');\n  chunks.push({\n    message: `## VIRYA \u2014 organic engagement ${i+1}-${Math.min(i+10, usable.length)}/${usable.length}\\nKliknij r\u0119cznie, przeczytaj post i reaguj tylko wtedy, gdy komentarz naprawd\u0119 pasuje.\\n\\n${block}`\n  });\n}\nreturn chunks.map(x => ({json:x}));"
   },
   "typeVersion": 2
  },
