   "name": "Validate invitation job",
   "type": "n8n-nodes-base.code",
   "position": [
    1264,
    -288
   ],
   "parameters": {
    "jsCode": "const e=$json; if(!e||e.type!=='crowdrelay.beacon.invite_delivery_requested'||e.version!==1||!e.data?.job_id) throw new Error('Unsupported event: got type='+((e&&e.type)||'(none)')+' version='+((e&&e.version)||'(none)')+' expected crowdrelay.beacon.invite_delivery_requested v1'); return [{json:{event_id:e.id,job_id:e.data.job_id}}];"
   },
   "typeVersion": 2
  },
  {
   "id": "767aa800-235e-49f6-9809-4cf40cee2f22",
   "name": "Claim once and mint response-only invites",
   "type": "n8n-nodes-base.httpRequest",
   "position": [
    1536,
    -288
   ],
   "parameters": {
    "url": "={{ 'https://signal-api.virya.music' + '/v1/internal/beacon/invite-delivery-jobs/' + $json.job_id + '/claim' }}",
    "body": "={{ JSON.stringify({workerId:$env.VIRYA_N8N_EXECUTOR_ID}) }}",
    "method": "POST",
    "options": {
     "timeout": 10000
    },
    "sendBody": true,
    "contentType": "raw",
    "sendHeaders": true,
    "rawContentType": "application/json",
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "={{ 'Bearer ' + $env.CROWDRELAY_COMMERCE_API_KEY }}"
      }
     ]
    }
   },
   "typeVersion": 4.2
  },
  {
   "id": "634437a3-a3d4-4589-905d-915e03639259",
   "name": "Split server-owned invitation copy",
   "type": "n8n-nodes-base.code",
   "position": [
    1792,
    -288
   ],
   "parameters": {
    "jsCode": "const claim=$json; const inv=claim.batch?.invitations??[]; return inv.map(x=>({json:{job_id:claim.jobId,claim_token:claim.claimToken,to:x.contactEmail,subject:x.delivery.subject,text:x.delivery.text}}));"
   },
   "typeVersion": 2
  },
  {
   "id": "c412a144-af03-4a44-ad2c-b261bbfd73da",
