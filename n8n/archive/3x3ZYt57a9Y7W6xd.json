{"updatedAt":"2026-08-11T13:01:05.382Z","createdAt":"2026-07-24T09:45:08.790Z","id":"3x3ZYt57a9Y7W6xd","name":"END-01 — Draft Factory","description":null,"active":false,"isArchived":false,"nodes":[{"id":"ce006b7d-5f2b-40aa-b690-3567471c6ff4","name":"Monday — prepare pitches 09:30","type":"n8n-nodes-base.scheduleTrigger","position":[1104,288],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 30 9 * * 1"}]}},"typeVersion":1.2,"notesInFlow":true,"notes":"Light runtime cadence: 0 30 9 * * 1 (Europe/Warsaw). Workflow logic and data mappings unchanged."},{"id":"01814090-e138-4a39-bbb3-b1a0cf972691","name":"Manual","type":"n8n-nodes-base.manualTrigger","position":[1104,512],"parameters":{},"typeVersion":1},{"id":"63cba3fa-1ec1-44a4-b35f-0cb17b572c99","name":"GS — Read BRANDS","type":"n8n-nodes-base.googleSheets","position":[1360,160],"parameters":{"options":{"dataLocationOnSheet":{"values":{"rangeDefinition":"specifyRange","headerRow":1,"firstDataRow":2}}},"sheetName":{"__rl":true,"mode":"name","value":"BRANDS"},"documentId":{"__rl":true,"mode":"id","value":"1mseLpVLGCmb__g7yPvORp2f8dVSzn1lsWI5_zkAhA_k"}},"credentials":{"googleSheetsOAuth2Api":{"id":"bc2Y1XmIdyu5ySTa","name":"Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true,"retryOnFail":true,"maxTries":5,"waitBetweenTries":15000},{"id":"264f806f-6b87-4d53-9857-b2838e1aa3e2","name":"GS — Read MAILER","type":"n8n-nodes-base.googleSheets","position":[1360,384],"parameters":{"options":{"dataLocationOnSheet":{"values":{"rangeDefinition":"specifyRange","headerRow":1,"firstDataRow":2}}},"sheetName":{"__rl":true,"mode":"name","value":"MAILER"},"documentId":{"__rl":true,"mode":"id","value":"1mseLpVLGCmb__g7yPvORp2f8dVSzn1lsWI5_zkAhA_k"}},"credentials":{"googleSheetsOAuth2Api":{"id":"bc2Y1XmIdyu5ySTa","name":"Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true,"retryOnFail":true,"maxTries":5,"waitBetweenTries":15000},{"id":"34b1d2c6-af9a-425b-8285-afd96ed42c57","name":"GS — Read SETTINGS","type":"n8n-nodes-base.googleSheets","position":[1360,608],"parameters":{"options":{"dataLocationOnSheet":{"values":{"rangeDefinition":"specifyRange","headerRow":1,"firstDataRow":2}}},"sheetName":{"__rl":true,"mode":"name","value":"SETTINGS"},"documentId":{"__rl":true,"mode":"id","value":"1mseLpVLGCmb__g7yPvORp2f8dVSzn1lsWI5_zkAhA_k"}},"credentials":{"googleSheetsOAuth2Api":{"id":"bc2Y1XmIdyu5ySTa","name":"Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true,"retryOnFail":true,"maxTries":5,"waitBetweenTries":15000},{"id":"4bfa5114-12cb-47e8-9cc4-c303f524ef29","name":"Merge — brands + mailer","type":"n8n-nodes-base.merge","position":[1616,288],"parameters":{},"typeVersion":3},{"id":"7c07cf49-fe46-43d9-9891-45021ed45283","name":"Merge — all inputs","type":"n8n-nodes-base.merge","position":[1840,384],"parameters":{},"typeVersion":3},{"id":"3e3dc8bc-9c40-41ad-8f48-fd8cc1fa786c","name":"Code — Select and build prompt","type":"n8n-nodes-base.code","position":[2064,384],"parameters":{"jsCode":"\nconst brands=$items('GS — Read BRANDS').map(i=>i.json).filter(r=>r.Target_ID && r.Target_ID!=='TEMPLATE');\nconst mailer=$items('GS — Read MAILER').map(i=>i.json).filter(r=>r.Queue_ID && r.Queue_ID!=='TEMPLATE');\nconst settings=Object.fromEntries($items('GS — Read SETTINGS').map(i=>[String(i.json.Key||''),i.json.Value]));\nconst minFit=Number(settings.MIN_FIT_SCORE||75);\nconst maxDrafts=Math.max(1,Math.min(8,Number(settings.MAX_DRAFTS_PER_RUN||5)));\nconst existing=new Set(mailer.map(r=>String(r.Target_ID||'')));\nconst emailOk=e=>/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(e||''));\nconst proofBlocked=s=>['WAIT_PARTNER_PUBLICATION','NEEDS_PICKUP_VIDEO','BLOCKED'].includes(String(s||'').toUpperCase());\nconst rows=brands\n .filter(r=>String(r.Timing||'').toUpperCase()==='NOW')\n .filter(r=>Number(r.Fit_Score||0)>=minFit)\n .filter(r=>emailOk(r.Contact_Email))\n .filter(r=>!proofBlocked(r.Proof_Status))\n .filter(r=>!['BLOCKED','UNVERIFIED'].includes(String(r.Contact_Status||'').toUpperCase()))\n .filter(r=>!existing.has(String(r.Target_ID)))\n .sort((a,b)=>Number(b.Fit_Score||0)-Number(a.Fit_Score||0))\n .slice(0,maxDrafts);\nif(!rows.length) return [];\nconst prompt=`Write concise, highly personalized endorsement/collaboration emails for Wojciech Bator, guitarist in Virya (modern metal, Wroclaw, Poland).\nReturn STRICT JSON array. Each object: Target_ID, Language, Subject, Body.\nRules:\n- 120-190 words; natural, professional and specific.\n- Never ask bluntly for free gear.\n- Ask whether artist pricing, product trial, creator collaboration or a small case study makes sense.\n- Do not invent metrics, contacts, product use or achievements.\n- Mention actual use only when Relationship clearly says CURRENT/USER/OWNED.\n- Use exactly one best Proof_URL plus EPK if useful.\n- Explain one concrete content/test idea based on Product_or_Angle and What_We_Offer.\n- For Polish brands write Polish; otherwise English.\n- No generic compliments and no exaggerated fandom.\nTargets:\\n${JSON.stringify(rows)}`;\nconst payload={contents:[{role:'user',parts:[{text:prompt}]}],generationConfig:{temperature:0.35,responseMimeType:'application/json',maxOutputTokens:4200}};\nreturn [{json:{rows,payload:JSON.stringify(payload)}}];\n"},"typeVersion":2},{"id":"ab33ec5e-73e0-4895-a848-bf6797ce1265","name":"AI — Personalized pitches","type":"n8n-nodes-base.httpRequest","position":[2320,384],"parameters":{"url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent","body":"={{ $json.payload }}","method":"POST","options":{"timeout":90000,"response":{"response":{"neverError":true}}},"sendBody":true,"contentType":"raw","authentication":"genericCredentialType","rawContentType":"application/json","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"8LSEwbWubxhnFYYB","name":"Header Auth account"}},"typeVersion":4.4,"continueOnFail":true,"alwaysOutputData":true},{"id":"6909ddd1-e11d-4e83-87fc-3e4b717c3c11","name":"Code — Parse drafts","type":"n8n-nodes-base.code","position":[2576,384],"parameters":{"jsCode":"\nconst response=$json||{};\nconst status=Number(response.statusCode||response.status||0);\nif(response.error || status>=400){\n  const msg=String(response.error?.message||response.message||response.body?.error?.message||`HTTP ${status||'error'}`);\n  throw new Error(`Gemini pitch generation failed: ${msg.slice(0,500)}`);\n}\nlet text=(response.candidates?.[0]?.content?.parts||[]).map(p=>String(p.text||'')).join('').trim();\nif(!text && response.body){\n  const b=response.body;\n  text=typeof b==='string'?b:(b.candidates?.[0]?.content?.parts||[]).map(p=>String(p.text||'')).join('');\n}\nif(!text) throw new Error('Gemini returned an empty pitch response');\nlet arr;\ntry{arr=JSON.parse(text)}\ncatch{\n  const m=text.match(/\\[[\\s\\S]*\\]/);\n  if(!m) throw new Error('Gemini response does not contain a JSON array');\n  try{arr=JSON.parse(m[0])}catch(e){throw new Error(`Invalid Gemini JSON: ${e.message}`)}\n}\nif(!Array.isArray(arr)) throw new Error('Gemini response must be a JSON array');\nconst rows=$('Code — Select and build prompt').item.json.rows||[];\nconst byId=new Map(rows.map(r=>[String(r.Target_ID),r]));\nconst now=new Date().toISOString();\nconst seen=new Set();\nconst out=[];\nfor(let i=0;i<arr.length;i++){\n  const p=arr[i]||{};\n  const base=byId.get(String(p.Target_ID||''))||rows[i];\n  if(!base) continue;\n  const id=String(base.Target_ID||'').trim();\n  const brand=String(base.Brand||'').trim();\n  if(!id||seen.has(id)) continue;\n  seen.add(id);\n  const subject=String(p.Subject||'').trim();\n  const body=String(p.Body||'').trim();\n  if(!subject||!body) continue;\n  out.push({json:{\n    Queue_ID:`ENDQ-${Date.now()}-${String(out.length+1).padStart(2,'0')}`,\n    Target_ID:id,\n    Brand:brand,\n    Contact_Email:String(base.Contact_Email||'').trim(),\n    Contact_Route:String(base.Official_Route||'').trim(),\n    Language:String(p.Language||((base.Country==='Poland')?'PL':'EN')).toUpperCase(),\n    Subject:subject,\n    Body:body,\n    Status:'READY_TO_SEND',\n    Created_At:now,\n    Sent_At:'',\n    Follow_Up_At:'',\n    Follow_Up_Count:0,\n    Reply_At:'',\n    Reply_Class:'',\n    Reply_Summary:'',\n    Message_ID:'',\n    Thread_IDs:'',\n    Dedupe_Key:`${id}|initial`,\n    Last_Error:''\n  }});\n}\nif(!out.length) throw new Error('Gemini returned no usable endorsement drafts');\nreturn out;\n"},"typeVersion":2},{"id":"142915a6-40b5-4119-b29b-833c0d5aec6e","name":"GS — Append MAILER","type":"n8n-nodes-base.googleSheets","position":[2832,320],"parameters":{"columns":{"value":{"Body":"={{ $json.Body }}","Brand":"={{ $json.Brand }}","Status":"={{ $json.Status }}","Sent_At":"={{ $json.Sent_At }}","Subject":"={{ $json.Subject }}","Language":"={{ $json.Language }}","Queue_ID":"={{ $json.Queue_ID }}","Reply_At":"={{ $json.Reply_At }}","Target_ID":"={{ $json.Target_ID }}","Created_At":"={{ $json.Created_At }}","Dedupe_Key":"={{ $json.Dedupe_Key }}","Last_Error":"={{ $json.Last_Error }}","Message_ID":"={{ $json.Message_ID }}","Thread_IDs":"={{ $json.Thread_IDs }}","Reply_Class":"={{ $json.Reply_Class }}","Follow_Up_At":"={{ $json.Follow_Up_At }}","Contact_Email":"={{ $json.Contact_Email }}","Contact_Route":"={{ $json.Contact_Route }}","Reply_Summary":"={{ $json.Reply_Summary }}","Follow_Up_Count":"={{ $json.Follow_Up_Count }}"},"schema":[{"id":"Queue_ID","type":"string","display":true,"removed":false,"required":false,"displayName":"Queue_ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Target_ID","type":"string","display":true,"removed":false,"required":false,"displayName":"Target_ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Brand","type":"string","display":true,"removed":false,"required":false,"displayName":"Brand","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Contact_Email","type":"string","display":true,"removed":false,"required":false,"displayName":"Contact