{"updatedAt":"2026-07-27T12:54:29.784Z","createdAt":"2026-07-27T12:18:56.125Z","id":"gvOeuPmCbgsaWRKt","name":"META REVIEW 02 — Publish Instagram Story — FIXED","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"content":"# META APP REVIEW — Instagram Story\n\nDemonstracja `instagram_content_publish`:\n1. OAuth pobiera zarządzaną stronę i połączony Instagram Business.\n2. Tworzony jest kontener `media_type=STORIES` z `upload_type=resumable`.\n3. Workflow sprawdza przetwarzanie filmu.\n4. Publikuje Story przez `/media_publish`.\n\nWymagany publiczny URL po deployu patcha:\n`https://virya.music/meta-review/Ashes-story-test.mp4`\n\nW nodzie **Ustawienia demonstracji** zmień URL tylko, jeśli wdrażasz plik pod innym adresem. W dwóch nodach OAuth wybierz credential **Meta Virya OAuth2**.\n\nCrosspost IG → FB jest ustawieniem Accounts Center, a nie osobnym wywołaniem w tym workflow.\n\nPrzed uruchomieniem sprawdź, że URL MP4 zwraca bezpośrednio `Content-Type: video/mp4` i nie zwraca HTML, logowania ani challenge CDN/WAF.","height":660,"width":650},"id":"04f965f6-9414-438e-8049-c447e2d00faf","name":"Instrukcja","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1296,288]},{"parameters":{},"id":"3ff5566c-0e8d-4238-b442-073744f989d8","name":"Uruchom publikację testową","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[1360,1072]},{"parameters":{"jsCode":"return [{json:{\n  page_name_contains: 'Virya',\n  video_url: 'https://virya.music/meta-review/Ashes-story-test.mp4',\n  purpose: 'Meta App Review test Story'\n}}];"},"id":"2e9fa4b5-befd-4be4-9cd7-18db18a1fbeb","name":"Ustawienia demonstracji","type":"n8n-nodes-base.code","typeVersion":2,"position":[1584,1072]},{"parameters":{"url":"https://graph.facebook.com/v24.0/me/accounts","authentication":"genericCredentialType","genericAuthType":"oAuth2Api","sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"id,name,access_token,instagram_business_account{id,username}"}]},"options":{}},"id":"ee57763b-2b9b-4820-8a1e-abe6bee69ff7","name":"Pobierz strony przez OAuth","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1824,1072],"credentials":{"oAuth2Api":{"id":"u8PUa0YZcmFfEIGg","name":"Meta Virya OAuth2"}}},{"parameters":{"jsCode":"const config = $('Ustawienia demonstracji').first().json;\nconst pages = $input.first().json.data ?? [];\nconst page = pages.find(p => (p.name ?? '').toLowerCase().includes(config.page_name_contains.toLowerCase()))\n  ?? pages.find(p => p.instagram_business_account?.id)\n  ?? pages[0];\nif (!page?.access_token) throw new Error('Nie znaleziono strony z Page Access Token.');\nif (!page.instagram_business_account?.id) throw new Error('Strona nie ma połączonego Instagram Business.');\nreturn [{json:{\n  page_id: page.id,\n  page_name: page.name,\n  page_access_token: page.access_token,\n  ig_user_id: page.instagram_business_account.id,\n  ig_username: page.instagram_business_account.username ?? null,\n  video_url: config.video_url\n}}];"},"id":"e94405de-fe05-4dda-bed3-cbf19a8a1cdc","name":"Rozwiąż zasoby VIRYA","type":"n8n-nodes-base.code","typeVersion":2,"position":[2080,1072]},{"parameters":{"method":"POST","url":"={{ 'https://graph.facebook.com/v24.0/' + $json.ig_user_id + '/media' }}","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"name":"media_type","value":"STORIES"},{"name":"video_url","value":"={{$json.video_url}}"},{"name":"access_token","value":"={{$json.page_access_token}}"}]},"options":{}},"id":"69d24e9b-db95-4667-9c4f-ebce481a448d","name":"Utwórz kontener Story","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2368,1072]},{"parameters":{"amount":45},"id":"4dac4480-67bd-429e-8b52-a377664e4593","name":"Poczekaj 45 s","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2608,1072],"webhookId":"45a27cc9-4ff0-411a-84c1-003e441d472b"},{"parameters":{"url":"={{ 'https://graph.facebook.com/v24.0/' + $('Utwórz kontener Story').first().json.id }}","sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"status_code,status"},{"name":"access_token","value":"={{$('Rozwiąż zasoby VIRYA').first().json.page_access_token}}"}]},"options":{}},"id":"66d38390-6750-4fdc-9721-abcd17e8cd00","name":"Sprawdź kontener 1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2848,1072]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"84e0d612-a021-467b-8e99-f9e59cf88fdd","leftValue":"={{$json.status_code}}","rightValue":"FINISHED","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"db4ba6be-4d07-4af6-8b14-56fd962f72c0","name":"Gotowe po 45 s?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3088,1072]},{"parameters":{"amount":35},"id":"16fcbe71-2dfa-47bd-b874-d53fc120725b","name":"Poczekaj kolejne 35 s","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3088,1280],"webhookId":"2af565d9-86db-4c46-a28f-1da1cadd2416"},{"parameters":{"url":"={{ 'https://graph.facebook.com/v24.0/' + $('Utwórz kontener Story').first().json.id }}","sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"status_code,status"},{"name":"access_token","value":"={{$('Rozwiąż zasoby VIRYA').first().json.page_access_token}}"}]},"options":{}},"id":"757e01ec-b7f3-43d5-a1eb-1a318b5b7b84","name":"Sprawdź kontener 2","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3328,1280]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"4899cef5-242c-4e32-8ac4-03f9cf1895a2","leftValue":"={{$json.status_code}}","rightValue":"FINISHED","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"952ac8cb-6bd6-4bb6-9496-808bd14ee521","name":"Gotowe po 80 s?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3568,1280]}