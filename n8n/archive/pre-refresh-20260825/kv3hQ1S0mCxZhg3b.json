core})`).join(', ')||'brak';\nconst msg=`📊 **ENDORSEMENT — tydzień**\\nGotowe do wysłania: ${mail.filter(r=>r.Status==='READY_TO_SEND').length}\\nWysłane w 7 dni: ${sent}\\nOdpowiedzi w 7 dni: ${replies}\\nPozytywne/rokujące: ${positive}\\nAktywni partnerzy: ${partners.filter(r=>r.Status==='ACTIVE').length}\\nZaległe zobowiązania: ${overdue.length}\\n\\nNastępne marki: ${next}${overdue.length?`\\n\\n⚠️ Zaległe: ${overdue.slice(0,5).map(r=>r.Brand+' — '+r.Deliverable).join('; ')}`:''}`;\nreturn [{json:{content:msg}}];\n"},"typeVersion":2},{"id":"d8382005-00b4-438f-9d24-0ae53b06faac","name":"Send a message","type":"n8n-nodes-base.httpRequest","maxTries":3,"position":[1584,320],"parameters":{"url":"https://discord.com/api/v10/channels/1530129014155640872/messages","method":"POST","options":{"timeout":30000},"jsonBody":"={{ ({ content: String((($json.content)) ?? '').slice(0, 2000), allowed_mentions: ($json.allowed_mentions && typeof $json.allowed_mentions === 'object') ? $json.allowed_mentions : { parse: [] } }) }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","headerParameters":{"parameters":[{"name":"User-Agent","value":"Virya-n8n/1.0 (https://virya.music)"}]}},"credentials":{"httpHeaderAuth":{"id":"FB7ONYMUsZFfObWB","name":"Discord Bot HTTP"}},"retryOnFail":true,"typeVersion":4.4,"waitBetweenTries":1500}],"connections":{"Friday — partner digest 10:30":{"main":[[{"node":"GS — Read BRANDS","type":"main","index":0},{"node":"GS — Read MAILER","type":"main","index":0},{"node":"GS — Read PARTNERS","type":"main","index":0}]]},"Manual":{"main":[[{"node":"GS — Read BRANDS","type":"main","index":0},{"node":"GS — Read MAILER","type":"main","index":0},{"node":"GS — Read PARTNERS","type":"main","index":0}]]},"GS — Read BRANDS":{"main":[[{"node":"Merge — brands + mailer","type":"main","index":0}]]},"GS — Read MAILER":{"main":[[{"node":"Merge — brands + mailer","type":"main","index":1}]]},"Merge