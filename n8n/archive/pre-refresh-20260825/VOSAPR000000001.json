      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "jsCode": "const e=$json;if(!e||e.type!=='viryaos.autopilot.approval_requested'||e.version!==1) throw new Error('Unsupported approval event');const d=e.data??{};const clean=v=>String(v??'-').replace(/[\\r\\n\\t]+/g,' ').slice(0,300);const content=[`## VIRYA OS — POTRZEBUJĘ DECYZJI`,`**${clean(d.context)} · ${clean(d.action_kind)}**`,`Powód: ${clean(d.reason)}`,`Pewność: ${Number(d.confidence_basis_points||0)/100}%`,`Obiekt: ${clean(d.subject_kind)} · ${clean(d.subject_id)}`,`CR_EVENT_ID:${e.id}`].join('\\n\\n').slice(0,1950);return [{json:{content}}];"
      }
    },
    {
      "id": "3065bc5b-7b15-4cf4-8615-f154d356d346",
