{"updatedAt":"2026-08-11T18:07:04.363Z","createdAt":"2026-08-11T09:00:00.000Z","id":"VOSCAL000000001","name":"CrowdRelay — VIRYA OS Calendar executor","description":"Idempotent Calendar upsert. Intentionally inactive until VIRYA Google Calendar OAuth credential and VIRYA_GOOGLE_CALENDAR_ID are configured.","active":true,"isArchived":false,"nodes":[{"id":"ee1f315e-dc2d-4d9d-87f5-fe0a496c7c7f","name":"Called by verified ingress","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0],"parameters":{}},{"id":"c2d9c50a-cda0-49d7-9b10-b39d87a6e121","name":"Build calendar event","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0],"parameters":{"jsCode":"const e=$json;if(!e||e.type!=='viryaos.calendar.upsert_requested'||e.version!==1) throw new Error('Unsupported calendar event');const d=e.data??{};if(!d.calendar_key||!d.title||!d.starts_at) throw new Error('Invalid calendar payload');const key=String(d.calendar_key);let hex='';for(const ch of key){hex+=ch.codePointAt(0).toString(16)}const eventId=('v'+hex).slice(0,900);const start=new Date(d.starts_at);if(Number.isNaN(start.getTime())) throw new Error('Invalid starts_at');const end=new Date(start.getTime()+30*60*1000);const action_id=String(d.action_id||'').trim();if(!action_id) throw new Error('Missing action_id');return [{json:{event_id:e.id,action_id,eventId,title:String(d.title),start:start.toISOString(),end:end.toISOString(),description:`VIRYA OS · ${d.source_kind||'operation'} · ${d.source_id||''}\\nKey: ${key}`}}];"}},{"id":"b3735766-f550-47e8-abec-8dc81292e0fc","name":"Calendar — update if exists","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[520,0],"parameters":{"resource":"event","operation":"update","calendar":{"__rl":true,"value":"={{ $env.VIRYA_GOOGLE_CALENDAR_ID }}","mode":"id"},"eventId":"={{ $json.eventId }}","useDefaultReminders":true,"updateFields":{"start":"={{ $json.start }}","end":"={{ $json.end }}","summary":"={{ $json.title }}","description