{"updatedAt":"2026-08-05T14:20:10.904Z","createdAt":"2026-07-31T12:09:30.693Z","id":"crfbbaaa23e9a24a","name":"CrowdRelay — admission.pass.issued branch","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"5eac2837-d991-4048-a2f7-ce10c57e5013","name":"Called by verified ingress","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0]},{"parameters":{"jsCode":"const envelope = $json;\nif (!envelope || envelope.type !== 'admission.pass.issued' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst data = envelope.data ?? {};\nfor (const key of ['email', 'claim_token', 'public_reference', 'claim_expires_at']) {\n  if (data[key] === undefined || data[key] === null || data[key] === '') throw new Error(`Missing pass field: ${key}`);\n}\nconst base = (\"https://virya.music\" || '').replace(/\\/$/, '');\nif (!base) throw new Error('Missing CROWDRELAY_PUBLIC_SITE_URL');\nreturn [{ json: { event_id: envelope.id, mail: {\n  template: 'crowdrelay-admission-winner', to: data.email,\n  variables: { display_name: data.display_name ?? null, public_reference: data.public_reference, winner_url: `${base}/win#token=${encodeURIComponent(data.claim_token)}`, claim_expires_at: data.claim_expires_at },\n  idempotency_key: envelope.id\n} } }];"},"id":"32637fb1-314e-461e-9d49-6d8aab9428a1","name":"Validate and build action","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,0]},{"parameters":{"method":"POST","url":"http://virya-crowdrelay-n8n-bridge:8080/mailer","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Idempotency-Key","value":"={{ $json.event_id }}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify($json.mail) }}","options":{"timeout":40000},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"id":"d1b41bf4-d7dd-425e-8d58-e9b7347335a1","name":"Send through Virya mailer","ty