{"updatedAt":"2026-08-03T14:15:24.671Z","createdAt":"2026-07-31T12:29:22.394Z","id":"cr07d1fe0e43934a","name":"CrowdRelay — event.discord_report_due Discord branch","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"de522d98-2e7c-4e35-bcae-e0ff3f8e3335","name":"Called by verified ingress","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-860,0]},{"parameters":{"jsCode":"const envelope = $json;\nif (!envelope || envelope.type !== 'event.discord_report_due' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst event = envelope.data?.event ?? {};\nif (!event.slug || !event.title || !event.starts_at) throw new Error('Missing event fields');\nconst base = ($env.CROWDRELAY_PUBLIC_SITE_URL || 'https://virya.music').replace(/\\/$/, '');\nconst eventUrl = `${base}/pl/live/${encodeURIComponent(event.slug)}/`;\nconst date = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'full', timeStyle: 'short', timeZone: event.timezone || 'Europe/Warsaw' }).format(new Date(event.starts_at));\nconst place = [event.venue, event.city].filter(Boolean).join(' · ');\nconst marker = `CR_EVENT_ID:${envelope.id}`;\nconst content = [`## NOWY KONCERT`, `**${event.title}**`, date, place || null, `Bilety i szczegóły: ${eventUrl}`, marker].filter(Boolean).join('\\n\\n').slice(0, 2000);\nreturn [{ json: { envelope, eventUrl, marker, content } }];"},"id":"17e4a917-6b4b-4163-bbfa-a3166b001413","name":"Validate and build Discord report","type":"n8n-nodes-base.code","typeVersion":2,"position":[-600,0]},{"parameters":{"method":"GET","url":"https://discord.com/api/v10/channels/1529482376458276964/messages","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"User-Agent","value":"Virya-n8n/1.0 (https://virya.music)"}]},"sendQuery":true,"queryParameters":{"parameters":[{"name":"limit","value":"100"}]},"options":{"timeout":30000,"response":{"response":{"responseFormat":"json"}}}},"id":"2db3b1c6-c430-45c1-9c2d-df5a57776590","name":"Read recent Discord messages","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-340,0],"credentials":{"httpHeaderAuth":{"id":"FB7ONYMUsZFfObWB","name":"Discord Bot HTTP"}}},{"parameters":{"jsCode":"const source = $('Validate and build Discord report').first().json;\nconst values = $input.all().map(item => item.json);\nconst messages = values.flatMap(value => Array.isArray(value) ? value : [value]);\nconst found = messages.some(message => typeof message?.content === 'string' && message.content.includes(source.marker));\nreturn [{ json: { ...source, discordDone: found } }];"},"id":"7876ab54-9f14-4a2d-991c-a8d8bc06318e","name":"Check Discord external idempotency","type":"n8n-nodes-base.code","typeVersion":2,"position":[-80,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"ce1c0bb5-a2a8-4e66-92ea-6c032fcf1692","leftValue":"={{ $json.discordDone }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"a12c0644-dccc-4720-bf1b-46d5886e9c55","name":"Discord already published?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[180,0]},{"parameters":{"method":"POST","url":"https://discord.com/api/v10/channels/1529482376458276964/messages","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"User-Agent","value":"Virya-n8n/1.0 (https://virya.music)"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ ({ content: $json.content, allowed_mentions:{parse:[]} }) }}","options":{"timeout":30000}},"id":"bf403d89-31e8-474b-be71-f49d527beec8","name":"Post gig report to Discord","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,120],"credentials":{"httpHeaderAuth":{"id":"FB7ONYMUsZ