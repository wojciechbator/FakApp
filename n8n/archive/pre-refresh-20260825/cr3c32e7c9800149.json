{"updatedAt":"2026-08-03T14:20:22.472Z","createdAt":"2026-07-31T12:12:21.384Z","id":"cr3c32e7c9800149","name":"CrowdRelay — fan.created branch","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"c56ea950-04dd-4ace-9e95-3d810d4116da","name":"Called by verified ingress","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0]},{"parameters":{"jsCode":"const envelope = $json;\nconst supported = new Set(['fan.created', 'fan.reactivated']);\nif (!envelope || !supported.has(String(envelope.type)) || envelope.version !== 1) {\n  throw new Error('Unsupported CrowdRelay acquisition event');\n}\nconst data = envelope.data ?? {};\nif (!data.workspace_id || !data.fan_id || !data.email || !data.policy_version) {\n  throw new Error('Missing acquisition event fields');\n}\n// Double opt-in is authoritative. Welcome mail is sent only by fan.confirmed.\n// This branch deliberately performs validation only and persists no PII in n8n.\nreturn [{ json: {\n  accepted: true,\n  event_id: envelope.id,\n  event_type: envelope.type,\n  fan_id: data.fan_id,\n} }];"},"id":"66098d6c-78db-42c7-bf02-6506366ef63e","name":"Validate acquisition lifecycle","type":"n8n-nodes-base.code","typeVersion":2,"position":[280,0]},{"parameters":{},"id":"b959b2d7-f1a4-4ee6-8ea9-c28dafb980eb","name":"Acquisition event accepted","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[560,0]}],"connections":{"Called by verified ingress":{"main":[[{"node":"Validate acquisition lifecycle","type":"main","index":0}]]},"Validate acquisition lifecycle":{"main":[[{"node":"Acquisition event accepted","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","saveDataErrorExecution":"none","saveDataSuccessExecution":"none","saveManualExecutions":false,"errorWorkflow":"98d5e1a4-2dba-5e5a-9be1-2e5d9220859d"},"staticData":null,"meta":{"templateCredsSetupCompleted":false},"nodeGroups":[],"pinData":{},"versionId":"850d4a58-13c5-4199-affc-