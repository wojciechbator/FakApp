{"updatedAt":"2026-08-03T14:16:33.077Z","createdAt":"2026-07-31T07:15:39.558Z","id":"g5O26dWS8tEgLalW","name":"CrowdRelay — event.published Facebook branch","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"18178486-65ba-48d2-99a8-f53c12fcbd6a","name":"Called by verified ingress","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-1120,200]},{"parameters":{"method":"GET","url":"={{ ($env.CROWDRELAY_API_URL || 'https://signal-api.virya.music/v1').replace(/\\/$/, '') + '/public/events/' + encodeURIComponent($json.data.event.slug) }}","options":{"timeout":15000,"response":{"response":{"responseFormat":"json"}}}},"id":"e4b98dab-e310-44c3-b985-ea32a968f5df","name":"Read current CrowdRelay event","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-900,200],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"const envelope = $('Called by verified ingress').first().json;\nif (!envelope || envelope.type !== 'event.published' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst original = envelope.data?.event ?? {};\nconst current = $json ?? {};\nconst event = {\n  ...original,\n  ...current,\n  city: current.city?.name ?? original.city ?? null,\n  bandsintown_event_url: current.external_event_url ?? original.bandsintown_event_url ?? null,\n};\nif (!event.slug || !event.title || !event.starts_at) throw new Error('Missing event fields');\nconst base = ($env.CROWDRELAY_PUBLIC_SITE_URL || 'https://virya.music').replace(/\\/$/, '');\nconst eventUrl = `${base}/pl/live/${encodeURIComponent(event.slug)}/`;\nconst date = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'full', timeStyle: 'short', timeZone: event.timezone || 'Europe/Warsaw' }).format(new Date(event.starts_at));\nconst place = [event.venue, event.city].filter(Boolean).join(' · ');\nconst addTrigger = (value, trigger) => { try { const url = new URL(value); url.searchParams.set('trigger', trigger); return url.toString(); } catch { return null; } };\nconst rsvpUrl = addTrigger(event.bandsintown_event_url, 'rsvp_going');\nconst followUrl = $env.BANDSINTOWN_ARTIST_URL || 'https://www.bandsintown.com/a/15587796-virya?trigger=track';\nconst message = [\n  `NOWY KONCERT // ${event.title}`,\n  date,\n  place,\n  event.description || null,\n  `Bilety i szczegóły: ${eventUrl}`,\n  rsvpUrl ? `RSVP na Bandsintown: ${rsvpUrl}` : null,\n  `Obserwuj Viryę na Bandsintown: ${followUrl}`,\n].filter(Boolean).join('\\\\n\\\\n');\nreturn [{ json: { envelope, eventId: envelope.id, event, eventUrl, rsvpUrl, followUrl, message } }];"},"id":"a85267bc-de28-4113-bed4-79646dbbbeca","name":"Validate and build publication","type":"n8n-nodes-base.code","typeVersion":2,"position":[-660,200]},{"parameters":{"method":"GET","url":"https://graph.facebook.com/v24.0/me/accounts","authentication":"genericCredentialType","genericAuthType":"oAuth2Api","sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"id,name,access_token"},{"name":"limit","value":"100"}]},"options":{"timeout":30000,"response":{"response":{"responseFormat":"json"}}}},"id":"e2a1d0d5-1dc1-475f-aba5-9a90c513318e","name":"Get managed Facebook Pages","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-680,200],"credentials":{"oAuth2Api":{"id":"u8PUa0YZcmFfEIGg","name":"Meta Virya OAuth2"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"const source = $('Validate and build publication').first().json;\nconst pages = Array.isArray($json.data) ? $json.data : [];\nconst wanted = String($env.META_VIRYA_PAGE_ID || '').trim();\nconst page = pages.find(item => wanted && String(item.id) === wanted) || pages.find(item => /virya/i.test(String(item.name || '')));\nif (!page?.id || !page?.access_token) throw new Error('Virya Facebook Page not found');\nreturn [{ json: { ...source, pageId: String(page.id), pageAccessToken: String(page.access_to