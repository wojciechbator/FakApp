8ee","parameters":{"limit":100,"filters":{"q":"newer_than:14d -from:me"},"operation":"getAll"},"credentials":{"gmailOAuth2":{"id":"BJg5tKEWMNRw0GA1","name":"Gmail account"}},"typeVersion":2.1,"alwaysOutputData":true,"retryOnFail":true,"maxTries":4,"waitBetweenTries":15000},{"id":"35f6f66f-75de-41ac-a64a-91d2507a9979","name":"Merge — mailer + inbound","type":"n8n-nodes-base.merge","position":[1648,1280],"parameters":{},"typeVersion":3},{"id":"b0278afc-9c75-4056-99ee-711c17063843","name":"Code — Match replies","type":"n8n-nodes-base.code","position":[1904,1280],"parameters":{"jsCode":"\nconst rows=$items('GS — Reply MAILER').map(i=>i.json)\n  .filter(r=>['SENT','FOLLOWED_UP'].includes(String(r.Status||'')) && !r.Reply_At && r.Thread_IDs);\nconst msgs=$items('Gmail — Recent inbound').map(i=>i.json);\nconst out=[];\nconst seen=new Set();\nfor(const m of msgs){\n  const tid=String(m.threadId||m.thread_id||'').trim();\n  if(!tid) continue;\n  const q=rows.find(r=>String(r.Thread_IDs||'').split(';').map(x=>x.trim()).filter(Boolean).includes(tid));\n  if(!q || seen.has(String(q.Queue_ID))) continue;\n  seen.add(String(q.Queue_ID));\n  const body=String(m.textPlain||m.text||m.snippet||'').replace(/\\s+/g,' ').trim().slice(0,1200);\n  const low=body.toLowerCase();\n  let cls='OTHER';\n  if(/out of office|automatic reply|auto.?reply|automatyczna odpowiedź|poza biurem/.test(low)) cls='OUT_OF_OFFICE';\n  else if(/not interested|no thank|unfortunately|declin|nie jesteśmy zainteresowani|nie tym razem|odmawiam/.test(low)) cls='DECLINED';\n  else if(/interested|sounds good|let'?s|artist pricing|collaboration|send.*details|chętnie|zainteresowani|porozmawiajmy|podeślij/.test(low)) cls='INTERESTED';\n  else cls='NEUTRAL';\n  const ts=Number(m.internalDate||Date.now());\n  out.push({json:{\n    Queue_ID:String(q.Queue_ID),\n    Target_ID:String(q.Target_ID),\n    Brand:String(q.Brand||''),\n    Status:'REPLIED',\n    Reply_At:new Date(Number.isFinite(ts)?ts:Date.now()).toISOString(),\n 