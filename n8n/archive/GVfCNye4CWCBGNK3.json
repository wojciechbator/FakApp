_k"}},"credentials":{"googleSheetsOAuth2Api":{"id":"bc2Y1XmIdyu5ySTa","name":"Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true,"retryOnFail":true,"maxTries":5,"waitBetweenTries":15000},{"id":"a03c5b35-dc20-484c-816d-02bb8d7bbfb4","name":"GS — Send BRANDS","type":"n8n-nodes-base.googleSheets","position":[1392,896],"parameters":{"options":{"dataLocationOnSheet":{"values":{"rangeDefinition":"specifyRange","headerRow":1,"firstDataRow":2}}},"sheetName":{"__rl":true,"mode":"name","value":"BRANDS"},"documentId":{"__rl":true,"mode":"id","value":"1mseLpVLGCmb__g7yPvORp2f8dVSzn1lsWI5_zkAhA_k"}},"credentials":{"googleSheetsOAuth2Api":{"id":"bc2Y1XmIdyu5ySTa","name":"Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true,"retryOnFail":true,"maxTries":5,"waitBetweenTries":15000},{"id":"86ec1692-3641-4516-adf7-3f9c03bc94d9","name":"Merge — send settings + mailer","type":"n8n-nodes-base.merge","position":[1632,624],"parameters":{},"typeVersion":3},{"id":"b157caf5-23c5-4392-a3ce-f6b00ef9e6f5","name":"Merge — send all","type":"n8n-nodes-base.merge","position":[1856,720],"parameters":{},"typeVersion":3},{"id":"0b079e5b-eb59-4e63-aff6-24c595af106f","name":"Code — Build send actions","type":"n8n-nodes-base.code","position":[2112,720],"parameters":{"jsCode":"\nconst settings=Object.fromEntries($items('GS — Send SETTINGS').map(i=>[String(i.json.Key||''),i.json.Value]));\nif(String(settings.SEND_ENABLED||'FALSE').toUpperCase()!=='TRUE') return [];\nconst mailer=$items('GS — Send MAILER').map(i=>i.json).filter(r=>r.Queue_ID&&r.Queue_ID!=='TEMPLATE');\nconst brands=$items('GS — Send BRANDS').map(i=>i.json).filter(r=>r.Target_ID);\nconst brandById=new Map(brands.map(r=>[String(r.Target_ID),r]));\nconst today=new Date().toISOString().slice(0,10);\nconst sendLimit=Math.max(0,Number(settings.DAILY_SEND_LIMIT||2));\nconst followLimit=Math.max(0,Number(settings.DAILY_FOLLOWUP_LIMIT||1));\nconst followEnabled=String(settings.AUTO_FOLLOWUP_ENABLED||'TRUE').toUpperCase()==='TRUE';\nconst alreadySent=mailer.filter(r=>String(r.Sent_At||'').slice(0,10)===today).length;\nconst alreadyFollow=mailer.filter(r=>String(r.Status||'')==='FOLLOWED_UP' && String(r.Follow_Up_At||'').slice(0,10)===today).length;\nconst initialSlots=Math.max(0,sendLimit-alreadySent);\nconst followSlots=Math.max(0,followLimit-alreadyFollow);\nconst now=Date.now();\nconst emailOk=e=>/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(e||''));\nconst actions=[];\nif(followEnabled && followSlots>0){\n const due=mailer.filter(r=>r.Status==='SENT' && !r.Reply_At && Number(r.Follow_Up_Count||0)<1 && r.Follow_Up_At && new Date(r.Follow_Up_At).getTime()<=now)\n  .sort((a,b)=>new Date(a.Follow_Up_At)-new Date(b.Follow_Up_At)).slice(0,followSlots);\n for(const r of due){\n  const body=String(r.Language||'EN').toUpperCase()==='PL'\n   ? `Cześć,\\n\\nwracam tylko raz do poniższej propozycji. Jeśli temat współpracy, testu produktu lub artist pricingu nie jest teraz aktualny, nie będę ponawiał wiadomości.\\n\\nMogę też podesłać krótszy, konkretny plan materiału pod wskazany produkt.\\n\\nPozdrawiam,\\nWojtek Bator / Virya`\n   : `Hello,\\n\\nJust one brief follow-up on the collaboration idea below. If artist pricing, a product trial or a small creator collaboration is not relevant right now, I will not keep following up.\\n\\nI can also send a shorter product-specific content plan if useful.\\n\\nBest,\\nWojciech Bator / Virya`;\n  actions.push({json:{...r,Action:'FOLLOWUP',SendTo:r.Contact_Email,SendSubject:`Re: ${r.Subject}`,SendBody:body}});\n }\n}\nif(initialSlots>0){\n const ready=mailer.filter(r=>r.Status==='READY_TO_SEND' && !r.Sent_At && !r.Reply_At && emailOk(r.Contact_Email))\n  .filter(r=>{const b=brandById.get(String(r.Target_ID)); if(!b) return false; if(b.Cooldown_Until && new Date(b.Cooldown_Until).getTime()>now) return false; return true;})\n  .sort((a,b)=>Number(brandById.get(String(b.Target_ID))?.Fit_Score||0)-Number(brandById.get(String(a.Target_ID))?.Fit_Score||0))\n  .slice(0,initialSlots);\n for(const r of ready) actions.push({json:{...r,Action:'INITIAL',SendTo:r.Contact_Email,SendSubject:r.Subject,SendBody:r.Body}});\n}\nreturn actions;\n"},"typeVersion":2},{"id":"b1e29b61-e742-4ea5-a581-c06a4ade39a5","name":"Gmail — AUTO SEND","type":"n8n-nodes-base.gmail","position":[2384,720],"webhookId":"56b86498-53f0-4cab-bd5b-8cec8118f763","parameters":{"sendTo":"={{ $json.SendTo }}","message":"={{ $json.SendBody }}","options":{"senderName":"Wojciech Bator / Virya","appendAttribution":false},"subject":"={{ $json.SendSubject }}","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"BJg5tKEWMNRw0GA1","name":"Gmail account"}},"typeVersion":2.1,"continueOnFail":true,"alwaysOutputData":true},{"id":"578a11da-4ee2-4e80-947f-3bb4388a5ff6","name":"Code — Mark send result","type":"n8n-nodes-base.code","position":[2640,720],"parameters":{"jsCode":"\nconst q=$('Code — Build send actions').item.json||{};\nif(!q.Queue_ID) throw new Error('Brak Queue_ID dla wyniku Gmail');\nconst err=$json.error || ($json.message && ['AxiosError','NodeApiError'].includes(String($json.name||'')));\nif(err){\n  return [{json:{...q,Status:'FAILED',Last_Error:String($json.error?.message||$json.message||'Gmail send failed').slice(0,500)}}];\n}\nconst now=new Date();\nconst msg=String($json.id||$json.messageId||'');\nconst tid=String($json.threadId||$json.thread_id||'');\nconst ids=[...new Set([String(q.Thread_IDs||'').trim(),tid].filter(Boolean))].join(';');\nif(q.Action==='FOLLOWUP'){\n  return [{json:{...q,Status:'FOLLOWED_UP',Follow_Up_Count:1,Follow_Up_At:now.toISOString(),Message_ID:msg,Thread_IDs:ids,Last_Error:''}}];\n}\nconst days=Math.max(1,Number($items('GS — Send SETTINGS').find(i=>i.json.Key==='FOLLOWUP_AFTER_DAYS')?.json.Value||10));\nconst follow=new Date(now);\nfollow.setDate(follow.getDate()+days);\nreturn [{json:{...q,Status:'SENT',Sent_At:now.toISOString(),Follow_Up_At:follow.toISOString(),Follow_Up_Count:0,Message_ID:msg,Thread_IDs:ids,Last_Error:''}}];\n"},"typeVersion":2},{"id":"b00e7d0a-67b6-45bb-ba97-1e59789ba16a","name":"GS — Update MAILER","type":"n8n-nodes-base.googleSheets","position":[2896,624],"parameters":{"columns":{"value":{"Status":"={{ $json.Status }}","Sent_At":"={{ $json.Sent_At }}","Queue_ID":"={{ $json.Queue_ID }}","Last_Error":"={{ $json.Last_Error }}","Message_ID":"={{ $json.Message_ID }}","Thread_IDs":"={{ $json.Thread_IDs }}","Follow_Up_At":"={{ $json.Follow_Up_At }}","Follow_Up_Count":"={{ $json.Follow_Up_Count }}"},"schema":[{"id":"Queue_ID","type":"string","display":true,"removed":false,"required":false,"displayName":"Queue_ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Target_ID","type":"string","display":true,"removed":false,"required":false,"displayName":"Target_ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Brand","type":"string","display":true,"removed":false,"required":false,"displayName":"Brand","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Contact_Email","type":"string","display":true,"removed":false,"required":false,"displayName":"Contact_Email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Contact_Route","type":"string","display":true,"removed":false,"required":false,"displayName":"Contact_Route","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Language","type":"string","display":true,"removed":false,"required":false,"displayName":"Language","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Subject","type":"string","display":true,"removed":false,"required":false,"displayName":"Subject","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Body","type":"string","display":true,"removed":false,"required":false,"displayName":"Body","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"removed":false,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Created_At","type":"string","display":true,"removed":false,"required":false,"displayName":"Created_At","defaultM