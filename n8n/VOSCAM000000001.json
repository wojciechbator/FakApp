  {
   "parameters": {
    "jsCode": "const plan=$json; const src=$('Validate campaign').first().json;if(plan.next_after_fan_id) throw new Error('Campaign >500 recipients: pagination intentionally requires follow-up implementation before auto-send');const rec=Array.isArray(plan.recipients)?plan.recipients:[];const key=src.template_key;const content=(plan.campaign&&plan.campaign.content)||{};const resolveCta=(v)=>{if(!v)return '';const s=String(v);return s.startsWith('env:')?String($env[s.slice(4)]||''):s;};const ctas=content.growth_ctas||{};const ctaLines=[['Spotify',resolveCta(ctas.spotify_artist_url)],['Bandsintown',resolveCta(ctas.bandsintown_follow_url)],['Playlista',resolveCta(ctas.spotify_playlist_url)]].filter(([,u])=>u).map(([l,u])=>l+': '+u);const ticketUrl=content.ticket_url?String(content.ticket_url):'';if(ticketUrl)ctaLines.push('Koncert: '+ticketUrl);const copy=(r)=>{const pl=String(r.locale||'pl').toLowerCase().startsWith('pl');const name=String(r.display_name||'').trim();const hi=pl?(name?`Cze\u015b\u0107 ${name}!`:'Cze\u015b\u0107!'):(name?`Hi ${name}!`:'Hi!');const map={\n'show.growth.free_fan_push.v1':['VIRYA \u2014 obserwuj nas i nie przegap koncertu','VIRYA \u2014 follow us and catch the show'],\n'release.announcement.v1':['Nowa premiera VIRYA nadchodzi','A new VIRYA release is coming'],\n'release.fan_warmup.v1':['VIRYA \u2014 premiera coraz bli\u017cej','VIRYA \u2014 release incoming'],\n'release.countdown.v1':['VIRYA \u2014 ju\u017c za chwil\u0119','VIRYA \u2014 almost there'],\n'release.release_day.v1':['Nowa premiera VIRYA \u2014 dzi\u015b','New VIRYA release \u2014 today'],\n'release.sustain.v1':['S\u0142yszeli\u015bcie ju\u017c now\u0105 VIRYA?','Have you heard the new VIRYA release?'],\n'release.wrap.v1':['Dzi\u0119ki za premier\u0119 z VIRYA','Thanks for joining the VIRYA release'],\n'event.announcement.v1':['VIRYA \u2014 nowy koncert','VIRYA \u2014 new show'],\n'event.interest_reminder.v1':['VIRYA \u2014 przypomnienie o koncercie','VIRYA \u2014 show reminder'],\n'event.last_call.v1':['VIRYA \u2014 ostatni moment przed koncertem','VIRYA \u2014 last call before the show'],\n'event.day_of.v1':['VIRYA \u2014 widzimy si\u0119 dzi\u015b','VIRYA \u2014 see you today'],\n'event.thank_you.v1':['Dzi\u0119ki za koncert z VIRYA','Thanks for the show with VIRYA']};const sub=(map[key]||['VIRYA \u2014 nowy sygna\u0142','VIRYA \u2014 new signal'])[pl?0:1];let body=pl?`${hi}\\n\\nMamy dla Ciebie aktualny sygna\u0142 VIRYA. Szczeg\u00f3\u0142y, muzyka i koncerty:\\nhttps://virya.music/pl/signal/\\n\\nDo zobaczenia,\\nVIRYA`:`${hi}\\n\\nHere is the latest VIRYA signal. Music, releases and shows:\\nhttps://virya.music/signal/\\n\\nSee you,\\nVIRYA`;if(ctaLines.length)body+='\\n\\n'+ctaLines.join('\\n');return {SendTo:r.email,SendSubject:sub,SendBody:body,fan_id:r.fan_id};};return rec.map(r=>({json:{...copy(r),campaign_id:src.campaign_id,event_id:src.event_id,attempt_key:`email:${src.campaign_id}:${r.fan_id}`}}));"
   },
