   "parameters": {
    "jsCode": "const src=$('Validate campaign').first().json;const d=$json?.delivery??{};const pending=Number(d.pending_count??-1),claimed=Number(d.claimed_count??-1);if(pending!==0||claimed!==0)throw new Error(`Campaign delivery still open pending=${pending} claimed=${claimed}`);const recipient_count=Number(d.eligible_count??-1),delivered_count=Number(d.delivered_count??-1),failed_count=Number(d.failed_count??-1);if([recipient_count,delivered_count,failed_count].some(v=>!Number.isInteger(v)||v<0)||delivered_count+failed_count!==recipient_count)throw new Error('Invalid authoritative campaign delivery progress');return [{json:{campaign_id:src.campaign_id,recipient_count,delivered_count,failed_count}}];"
