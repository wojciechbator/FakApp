    "jsCode": "const e=$json;if(!e||e.type!=='communication.campaign_due'||e.version!==1) throw new Error('Unsupported campaign event');const d=e.data??{};if(!d.campaign_id||!['email','push'].includes(d.channel)||!d.template_key) throw new Error('Invalid campaign payload');return [{json:{event_id:e.id,campaign_id:d.campaign_id,channel:String(d.channel),template_key:String(d.template_key),campaign_slug:String(d.campaign_slug||'')}}];"
