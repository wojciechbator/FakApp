 "nodes": [
  {
   "id": "a0d2eee7-3580-44dd-b2df-bf122b3ae484",
   "name": "Called by verified ingress",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "position": [
    0,
    0
   ],
   "parameters": {
    "inputSource": "passthrough"
   },
   "typeVersion": 1.1
  },
  {
   "id": "4f7c5f26-a5e2-4779-a6ed-be5892ed92ee",
   "name": "Validate server-owned release mail",
   "type": "n8n-nodes-base.code",
   "position": [
    272,
    0
   ],
   "parameters": {
    "jsCode": "const e=$json; if(!e||e.type!=='crowdrelay.beacon.release_delivery_confirmation_requested'||e.version!==1) throw new Error('Unsupported event'); const d=e.data??{}; if(!d.contact_email||!d.subject||!d.text||d.recipient_phone||d.parcel_locker_code||d.recipient_name) throw new Error('Invalid or shipment-PII-bearing release mail event'); return [{json:{event_id:e.id,to:d.contact_email,subject:d.subject,text:d.text}}];"
   },
   "typeVersion": 2
  },
  {
   "id": "a7b024cc-411b-4ae5-96a6-658223286f5f",
   "name": "Deliver confirmation mail",
   "type": "n8n-nodes-base.httpRequest",
   "position": [
    544,
    0
   ],
   "parameters": {
    "url": "={{ $env.VIRYA_MAIL_DELIVERY_URL }}",
    "body": "={{ JSON.stringify({to:$json.to,subject:$json.subject,text:$json.text}) }}",
    "method": "POST",
    "options": {
     "timeout": 15000
    },
    "sendBody": true,
    "contentType": "raw",
    "sendHeaders": true,
    "rawContentType": "application/json",
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "={{ 'Bearer ' + $env.VIRYA_MAIL_DELIVERY_TOKEN }}"
      },
      {
       "name": "Idempotency-Key",
       "value": "={{ $json.event_id }}"
      }
     ]
    }
   },
   "typeVersion": 4.2
  }
 ],
