  {
   "parameters": {
    "jsCode": "const envelope = $json;\nif (!envelope || envelope.type !== 'ticket.order.delivery_requested' || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst data = envelope.data ?? {};\nfor (const key of ['order_id','order_reference','event_slug','event_title','starts_at','buyer_email','checkout_token','tickets']) { if (data[key] === undefined || data[key] === null || data[key] === '') throw new Error(`Missing ticket field: ${key}`); }\nif (!Array.isArray(data.tickets) || !data.tickets.length) throw new Error('Missing tickets');\nreturn [{ json: envelope }];"
   },
   "id": "ff1b470e-ae11-4557-9330-637dcacb99eb",
   "name": "Validate ticket delivery",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://virya-crowdrelay-n8n-bridge:8080/ticket-mailer",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Idempotency-Key",
       "value": "={{ $json.id }}"
      }
     ]
    },
    "sendBody": true,
    "contentType": "raw",
    "rawContentType": "application/json",
    "body": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 40000
    },
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth"
   },
   "id": "d0579af1-d84e-4119-b344-b42366391c92",
   "name": "Send QR tickets through Virya",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
