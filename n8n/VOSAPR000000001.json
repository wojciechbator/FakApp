  {
   "id": "e8940d50-1f09-4365-b29b-292147f03feb",
   "name": "Build approval alert",
   "type": "n8n-nodes-base.code",
   "position": [
    250,
    0
   ],
   "parameters": {
    "jsCode": "const e=$json;if(!e||e.type!=='crowdrelay.autopilot.approval_requested'||e.version!==1) throw new Error('Unsupported approval event');const d=e.data??{};const clean=v=>String(v??'-').replace(/[\\r\\n\\t]+/g,' ').slice(0,300);const content=[`## VIRYA OS \u2014 POTRZEBUJ\u0118 DECYZJI`,`**${clean(d.context)} \u00b7 ${clean(d.action_kind)}**`,`Pow\u00f3d: ${clean(d.reason)}`,`Pewno\u015b\u0107: ${Number(d.confidence_basis_points||0)/100}%`,`Obiekt: ${clean(d.subject_kind)} \u00b7 ${clean(d.subject_id)}`,`CR_EVENT_ID:${e.id}`].join('\\n\\n').slice(0,1950);return [{json:{content}}];"
   },
   "typeVersion": 2
  },
  {
   "id": "3065bc5b-7b15-4cf4-8615-f154d356d346",
   "name": "Discord \u2014 approval required",
   "type": "n8n-nodes-base.httpRequest",
   "maxTries": 5,
   "position": [
    540,
    0
   ],
   "parameters": {
    "url": "={{ 'https://discord.com/api/v10/channels/' + ($env.DISCORD_OPS_CHANNEL_ID || '1529482376458276964') + '/messages' }}",
    "body": "={{ JSON.stringify({content:$json.content,allowed_mentions:{parse:[]}}) }}",
    "method": "POST",
    "options": {
     "timeout": 15000
    },
    "sendBody": true,
    "contentType": "raw",
    "authentication": "genericCredentialType",
    "rawContentType": "application/json",
    "genericAuthType": "httpHeaderAuth"
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "FB7ONYMUsZFfObWB",
     "name": "Discord Bot HTTP"
    }
   },
   "retryOnFail": true,
   "typeVersion": 4.4,
   "waitBetweenTries": 5000
  }
 ],
