  {
   "id": "494b231a-2e34-46f0-9862-daff90a7d45a",
   "name": "Validate and build change report",
   "type": "n8n-nodes-base.code",
   "position": [
    240,
    0
   ],
   "parameters": {
    "jsCode": "const envelope = $json;\nif (!envelope || !['event.updated','event.cancelled'].includes(envelope.type) || envelope.version !== 1) throw new Error('Unsupported CrowdRelay event');\nconst data = envelope.data ?? {};\nconst event = data.event ?? {};\nconst previous = data.previous ?? null;\nif (!event.slug || !event.title || !event.starts_at) throw new Error('Missing event fields');\nconst base = ($env.CROWDRELAY_PUBLIC_SITE_URL || 'https://virya.music').replace(/\\/$/, '');\nconst eventUrl = `${base}/pl/live/${encodeURIComponent(event.slug)}/`;\nconst tz = event.timezone || 'Europe/Warsaw';\nconst format = value => value ? new Intl.DateTimeFormat('pl-PL', { dateStyle:'full', timeStyle:'short', timeZone:tz }).format(new Date(value)) : '\u2014';\nconst kind = envelope.type === 'event.cancelled' ? 'ANULOWANY KONCERT' : 'ZMIANA KONCERTU';\nconst changes = [];\nif (previous?.starts_at && previous.starts_at !== event.starts_at) changes.push(`Termin: ${format(previous.starts_at)} \u2192 ${format(event.starts_at)}`);\nif ((previous?.venue || '') !== (event.venue || '')) changes.push(`Miejsce: ${previous?.venue || '\u2014'} \u2192 ${event.venue || '\u2014'}`);\nif ((previous?.venue_address || '') !== (event.venue_address || '')) changes.push(`Adres: ${previous?.venue_address || '\u2014'} \u2192 ${event.venue_address || '\u2014'}`);\nconst marker = `CR_EVENT_ID:${envelope.id}`;\nconst content = [`## ${kind}`, `**${event.title}**`, envelope.type === 'event.cancelled' ? 'Bandsintown usun\u0105\u0142 lub anulowa\u0142 ten przysz\u0142y termin.' : changes.join('\\n') || 'Zmieni\u0142y si\u0119 dane wydarzenia.', `Aktualny widok: ${eventUrl}`, marker].join('\\n\\n').slice(0,2000);\nreturn [{ json: { marker, content, eventUrl } }];"
   },
   "typeVersion": 2
  },
  {
