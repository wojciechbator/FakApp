       "name": "User-Agent",
       "value": "Virya-n8n/1.0 (https://virya.music)"
      }
     ]
    }
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "FB7ONYMUsZFfObWB",
     "name": "Discord Bot HTTP"
    }
   },
   "typeVersion": 4.2
  },
  {
   "id": "7876ab54-9f14-4a2d-991c-a8d8bc06318e",
   "name": "Check Discord external idempotency",
   "type": "n8n-nodes-base.code",
   "position": [
    -80,
    0
   ],
   "parameters": {
    "jsCode": "const source = $('Validate and build Discord report').first().json;\nconst values = $input.all().map(item => item.json);\nconst messages = values.flatMap(value => Array.isArray(value) ? value : [value]);\nconst found = messages.some(message => typeof message?.content === 'string' && message.content.includes(source.marker));\nreturn [{ json: { ...source, discordDone: found } }];"
   },
   "typeVersion": 2
  },
